# =============================================================================
# nexus dev 环境变量（演示项目 dev 默认值，无敏感信息，随仓库提交）
# compose 各引用处均有 :- 默认值兜底；需要改端口/凭据时只改本文件一处。
# =============================================================================

# ── PostgreSQL（镜像 pgvector/pgvector:pg16，pgvector 扩展已内置）──
PG_DB=nexus
PG_USER=nexus
PG_PASSWORD=nexus123
PG_PORT=5432

# ── Redis 7（dev 无密码：仅容器内网 + 本机映射；生产需 requirepass）──
REDIS_PORT=6379

# ── Ollama（CPU 推理；tag 已固定 0.33.2：2026-09-03 实测与 latest 同 manifest）──
OLLAMA_PORT=11434
OLLAMA_TAG=0.33.2

# ── 应用容器（此处仅宿主映射端口；容器内端口固定 backend 8089 / frontend 80）──
BACKEND_PORT=8089
FRONTEND_PORT=8088

# ── builder：容器内源码同步（2026-09-13 新增）──
# ⚠️ 硬约束：builder 容器只能拿到【已 push 到远端】的提交。
#    宿主工作区里未 commit / 已 commit 未 push 的改动，构建时**永远看不到**。
#    所以「改完想构建」的顺序是：commit → push → 容器内 git-sync → build-*。
# 约定工作流是「先合并到 main 再构建」，故默认 main；
# 只有确需构建某个**尚未合并**的分支时，才把它临时改成分支名。
NEXUS_REPO_URL=https://github.com/KeanuCao/nexus-agent-workbench.git
NEXUS_REPO_BRANCH=main
