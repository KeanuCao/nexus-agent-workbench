# =============================================================================
# nexus 测试环境变量（task.6 / 5.1 交付物；与 docker-compose.test.yml 必须成对使用）
#
# ⚠️ 用法（唯一正确写法，两条缺一不可）：
#   docker compose -f docker-compose.test.yml --env-file .env.test …
#   —— 只给 --env-file 不给 -f 会拿本文件去插值**开发** compose（deploy.py 有防呆断言拦它）。
#
# 约定：
#   · 本文件**不放任何敏感值**（无密钥/无口令机密），随仓库提交（与 .env 同性质）。
#     测试档不依赖云端模型（M4-③）⇒ 不需要 DEEPSEEK_API_KEY。
#   · 端口口径 B（2026-10-08 拍板）：只发布 12002 / 12005 / 12006 / 12007 / 12008；
#     12001 / 12003 / 12004 为**预留段**（应用库 / redis / ollama 不发布，仅容器内网消费）。
#   · 凭据沿用开发口径的非敏感默认值；如需隔离再改（改这里一处生效）。
# =============================================================================

# ── PostgreSQL（被测应用库；不发布宿主端口，builder / backend 走服务名）──
PG_DB=nexus
PG_USER=nexus
PG_PASSWORD=nexus123
# PG_PORT=12001  ← 预留（口径 B：不发布）,未使用故不定义

# ── PostgreSQL 结果库实例（结果库 + Metabase 应用库，同一实例两个空库）──
RESULTS_PG_DB=nexus_test_results
RESULTS_PG_USER=nexus
RESULTS_PG_PASSWORD=nexus123
RESULTS_PG_PORT=12002
METABASE_APP_DB=metabase_app

# ── 应用容器（仅发布的宿主端口；容器内端口固定 backend 8089 / frontend 80）──
BACKEND_PORT=12005
FRONTEND_PORT=12006

# ── Metabase / 报告 Nginx（Windows 浏览器入口）──
METABASE_PORT=12007
REPORT_PORT=12008
# ⚠️ Metabase 镜像 tag 待实测选定（设计 §6-2）；固定前别把它当"已定版本"
METABASE_TAG=latest

# ── Ollama（CPU 推理；tag 与开发环境同值，2026-09-03 实测固定）──
# OLLAMA_PORT=12004  ← 预留（口径 B：不发布）
OLLAMA_TAG=0.33.2

# ── RAG 问答的回答模型（2026-10-09 补：此前漏配 ⇒ /api/kb/ask 必回 503 + 20100）──
# 测试档不配云端密钥（M4-③）⇒ 回答只能走本地 Ollama（DEEPSEEK 缺密钥会直接 20100）。
# ⚠️ 光写本行到不了容器：还须被 docker-compose.test.yml 的 nexus-backend.environment 透传（已加）。
NEXUS_AI_RAG_ANSWER_MODEL_TYPE=OLLAMA

# ── builder：容器内源码同步（同开发环境的「必须先 push」硬约束）──
# CI 拉 PR head 用 `git-sync --ref`（exec 层传参）；下面的 BRANCH 是无 ref 时的兜底口径。
NEXUS_REPO_URL=https://github.com/KeanuCao/nexus-agent-workbench.git
NEXUS_REPO_BRANCH=main
